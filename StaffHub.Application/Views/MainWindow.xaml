<!-- Главное окно с вкладками: сотрудники, контрагенты, заказы. -->
<Window x:Class="StaffHub.Application.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StaffHub" Height="450" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="Сотрудники">
                <Grid DataContext="{Binding EmployeesVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Button Content="Добавить" Command="{Binding AddCommand}" Width="100" Margin="0,0,5,0"/>
                        <Button Content="Редактировать" Command="{Binding EditCommand}" Width="100" Margin="0,0,5,0"/>
                        <Button Content="Удалить" Command="{Binding DeleteCommand}" Width="100"/>
                        <TextBlock Text="Загрузка..." Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" AutoGenerateColumns="False" IsReadOnly="True" Margin="5">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="*"/>
                            <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="100"/>
                            <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Контрагенты">
                <Grid DataContext="{Binding CounterpartiesVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Button Content="Добавить" Command="{Binding AddCommand}" Width="100" Margin="0,0,5,0"/>
                        <Button Content="Редактировать" Command="{Binding EditCommand}" Width="100" Margin="0,0,5,0"/>
                        <Button Content="Удалить" Command="{Binding DeleteCommand}" Width="100"/>
                        <TextBlock Text="Загрузка..." Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Counterparties}" SelectedItem="{Binding SelectedCounterparty}" AutoGenerateColumns="False" IsReadOnly="True" Margin="5">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="ИНН" Binding="{Binding INN}" Width="120"/>
                            <DataGridTextColumn Header="Куратор" Binding="{Binding Curator.LastName}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Заказы">
                <Grid DataContext="{Binding OrdersVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Button Content="Добавить" Command="{Binding AddCommand}" Width="100" Margin="0,0,5,0"/>
                        <Button Content="Редактировать" Command="{Binding EditCommand}" Width="100" Margin="0,0,5,0"/>
                        <Button Content="Удалить" Command="{Binding DeleteCommand}" Width="100"/>
                        <TextBlock Text="Загрузка..." Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" AutoGenerateColumns="False" IsReadOnly="True" Margin="5">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="120"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding Employee.LastName}" Width="*"/>
                            <DataGridTextColumn Header="Контрагент" Binding="{Binding Counterparty.Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
